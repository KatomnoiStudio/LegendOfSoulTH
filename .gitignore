# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# build:models output — nothing in src/ loads .glb yet (game renders 2D sprites),
# regenerate locally with `npm run build:models` when actually needed; not shipped to deploy
public/models/

# One-off Python art-pipeline tooling (align/extract/split sprite sheets) — run locally by
# whoever processes character art, never invoked by CI/build; keep it out of the shared repo
scripts/

# Agent tool internal state — never shipped, machine-local only
.claude/coalhearth/
.claude/coalwash/
.coalmine.json
.coalboard/
# per-machine spend consent (fableConsent) — committing it would hand every clone a
# standing "yes" to real-money agent spawns that this machine's owner gave, not them
.claude/.coalboard.json

# Per-machine/per-editor local tool config — not project config, each dev's own setup
.claude/launch.json
.claude/settings.local.json

# The belt system — installed per machine from docs/BELT-PORT.md, never shared.
# It only functions where Claude Code loads .claude/agents/, and AGENT_REGISTRY.md holds
# live session ids that mean nothing on any other machine. The repo keeps the INSTALLER
# (docs/BELT-PORT.md) and nothing else; run it, and these appear locally.
.claude/belt/
.claude/agents/belt-*.md

# Cursor IDE local config — machine/cloud-agent only, not project config
.cursor/

# Antigravity (Gemini) local agent config — same class as .cursor/ above
.gemini/

# Personal/off-project notes — see .agents/rules/personal-scope-law.md
# (never goes in the shared, mandatory-read MEMORY.md)
MEMORY.local.md

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
coverage/
